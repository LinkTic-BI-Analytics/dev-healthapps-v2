# ─── Base de datos (PostgreSQL) ─────────────────────────────────────────────
# Solo servidor: NUNCA uses el prefijo NEXT_PUBLIC_ en estas variables.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health_apps
DB_USER=postgres
# Solo para desarrollo local.
DB_PASSWORD=postgres
# Esquema de PostgreSQL de la app (por defecto `app_health`). La app SOLO crea y modifica objetos
# en este esquema; `public` y los esquemas de Supabase (auth, storage, ...) están bloqueados.
DB_SCHEMA=app_health
# SSL: vacío o `disable` en local; `require` en Supabase (cifra la conexión).
DB_SSLMODE=

# Opcional. Si se define, tiene prioridad sobre DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# La aplicación agrega siempre ?schema=${DB_SCHEMA}. Formato:
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
#
# Supabase (ver scripts/supabase/app-health-setup.sql y el README): conéctate con el rol
# `app_health_owner`, nunca con `postgres`. Con el pooler de Supabase el usuario es
# `app_health_owner.<project-ref>` y para las migraciones se usa el modo sesión (puerto 5432).

# ─── Autenticación (WI-019) ─────────────────────────────────────────────────
# Solo servidor: NUNCA uses el prefijo NEXT_PUBLIC_.
# Secreto para firmar el access token (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres
# Duración del access token en minutos (normalmente 60).
JWT_ACCESS_TTL_MINUTES=60
# Duración del refresh token en minutos (por defecto 10080 = 7 días). No puede ser menor que el access token.
REFRESH_TOKEN_TTL_MINUTES=10080
# Cookies con Secure: auto (por defecto) = solo si la petición llega por HTTPS (también detrás de un proxy
# con x-forwarded-proto). Safari descarta cookies Secure recibidas por HTTP, incluso en localhost.
AUTH_COOKIE_SECURE=auto

# Primer superadmin creado por `pnpm db:seed` (solo se crea si no existe).
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=cambia-esta-contraseña

# ─── Worker de verificaciones (WI-010, ADR-004) ─────────────────────────────
# Opcional: `worker` (verificaciones automáticas) o `manual` (botón "Verificar ahora").
# Vacío = `manual` en Vercel (no admite procesos en segundo plano) y `worker` en el resto.
CHECKS_MODE=
# Cada cuántos segundos el worker busca servicios con la verificación vencida.
CHECK_TICK_SECONDS=5
# Verificaciones simultáneas por worker.
CHECK_CONCURRENCY=10
# Opcional: URL de control. Si falla, los fallos se registran como "skipped" (el monitor no tiene conexión).
MONITOR_CANARY_URL=
# Días que se conservan los resultados de verificación.
CHECK_RESULTS_RETENTION_DAYS=30
# Días que se conserva el historial de cambios de estado (base del uptime).
STATUS_HISTORY_RETENTION_DAYS=365
# Opcional: host al que se traduce localhost/127.0.0.1 en las URLs (docker-compose.yml usa host.docker.internal).
CHECK_LOCALHOST_ALIAS=
